# Copy to engine.env (gitignored) and fill in. In AWS these come from Secrets
# Manager / SSM, not a file. Values below are the Fonepay DEV sandbox + eSewa UAT.

# --- Database (overridden by docker-compose for the local mysql container) ---
DB_PASSWORD=rootpass
FLXPOP_DB_NAME=flxpop

# --- Fonepay (real secrets — do NOT commit the filled-in engine.env) ---
FONEPAY_TERMINAL_ID=
FONEPAY_USERNAME=
FONEPAY_PASSWORD=
FONEPAY_PRIVATE_KEY_B64=
FONEPAY_BASE_URL=https://dev-external-gateway-new.fonepay.com/merchantThirdparty
FONEPAY_WEBHOOK_SECRET=dev-fonepay-webhook-secret

# --- eSewa (UAT defaults; secret-key required) ---
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
