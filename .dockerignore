# Keep the build context small AND keep secrets out of the image.
target/
.git
.gitignore
.github
.idea
*.iml
*.md
.DS_Store

# The web app builds in its own image (widget/Dockerfile).
widget/

# Secrets / vendor-private material — MUST NOT enter the image context.
reference-docs/
*.env
.env*

# Local-only
scripts/
db/
